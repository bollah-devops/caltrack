{
  "expo": {
    "name": "CalTrack",
    "slug": "caltrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.caltrack.app",
      "adaptiveIcon": {
        "backgroundColor": "#B93A6A"
      },
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "com.caltrack.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "a825af00-7c5a-4ab1-9fba-f6c88dd9e0a8"
      }
    }
  }
}
