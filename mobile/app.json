{
  "expo": {
    "name": "CalTrack",
    "slug": "caltrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["android", "ios"],
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.caltrack.app",
      "adaptiveIcon": {
        "backgroundColor": "#B93A6A"
      },
      "permissions": ["android.permission.CAMERA"]
    },
    "ios": {
      "bundleIdentifier": "com.caltrack.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan food barcodes."
      }
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Used to scan food barcodes." }]
    ]
  }
}
